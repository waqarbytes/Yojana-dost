{
  "name": "india-schemes-mcp",
  "version": "1.0.0",
  "description": "Production-grade MCP server for Indian Government Welfare Schemes (Yojana Dost)",
  "type": "module",
  "bin": {
    "india-schemes-mcp": "./dist/index.js"
  },
  "scripts": {
    "build:client": "esbuild src/client/main.tsx --bundle --minify --sourcemap --outfile=js/react-app.js --define:process.env.NODE_ENV=\\\"production\\\"",
    "build": "tsc && npm run build:client && node scripts/build-dist.js",
    "start": "node dist/index.js",
    "start:server": "tsx src/app.ts",
    "dev": "tsx src/index.ts",
    "ingest": "tsx scripts/ingest.ts",
    "eval:generate": "tsx eval/generate_queries.ts",
    "eval:run": "tsx eval/run.ts",
    "eval:report": "tsx eval/report.ts",
    "eval": "tsx eval/run.ts && tsx eval/report.ts",
    "loadtest": "tsx loadtest/run-loadtest.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "yojana",
    "government-schemes",
    "india",
    "welfare"
  ],
  "author": "Mohd Waqar",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
