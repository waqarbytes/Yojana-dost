# Server Port
PORT=3001

# AI / Generation API Key (OpenAI or NVIDIA NIM)
NVIDIA_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
GENERATION_MODEL=meta/llama-3.2-11b-vision-instruct

# RAG & Semantic Caching
RAG_ENABLED=true
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92

# Supabase Vector Store (Optional for hosted pgvector)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
